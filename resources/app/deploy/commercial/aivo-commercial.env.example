# Copy this file to the server env file and replace every placeholder.
# Never commit the real env file.

APP_ENV=production
DRY_RUN=false
STORAGE_DIR=/opt/aivo-commercial/storage

COMMERCIAL_REPOSITORY_BACKEND=postgres
COMMERCIAL_DATABASE_URL=postgresql://aivo_user:CHANGE_ME@127.0.0.1:5432/aivo_commercial

COMMERCIAL_ADMIN_USERNAME=digitalhuman
COMMERCIAL_ADMIN_PASSWORD_HASH=pbkdf2_sha256$260000$CHANGE_ME_SALT$CHANGE_ME_HASH
COMMERCIAL_ADMIN_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
COMMERCIAL_ADMIN_COOKIE_SECURE=true
COMMERCIAL_LOGIN_RATE_LIMIT_PER_MINUTE=5
COMMERCIAL_API_RATE_LIMIT_PER_MINUTE=60

COMMERCIAL_API_BASE_URL=https://api.digitalhumanagent.example.com
COMMERCIAL_RELEASE_PUBLIC_BASE_URL=https://api.digitalhumanagent.example.com
COMMERCIAL_BACKUP_RETENTION_DAYS=14
